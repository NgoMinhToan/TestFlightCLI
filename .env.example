# Runtime settings for the CLI. A `.env` file in the current directory is
# loaded automatically (existing environment variables win).
TESTFLIGHT_BASE_URL=http://127.0.0.1:8080
TESTFLIGHT_MANAGEMENT_KEY=
# TESTFLIGHT_PROFILE=default
# TESTFLIGHT_CONFIG=/absolute/path/to/config.json

# Publishing: set NPM_TOKEN as a GitHub Actions repository secret, never here.
# NPM_TOKEN=
