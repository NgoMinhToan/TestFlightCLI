{
  "name": "my-testflight-cli",
  "version": "0.1.0",
  "description": "Command-line client for MyTestflightServer: log in once, then create apps, publish APK releases and inspect the catalog from the terminal or CI.",
  "keywords": [
    "testflight",
    "android",
    "apk",
    "cli",
    "publish",
    "distribution",
    "my-testflight"
  ],
  "homepage": "https://github.com/NgoMinhToan/TestFlightCLI#readme",
  "bugs": {
    "url": "https://github.com/NgoMinhToan/TestFlightCLI/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NgoMinhToan/TestFlightCLI.git"
  },
  "license": "MIT",
  "author": "MyTestflight contributors",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "testflight": "dist/cli.js",
    "tf": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
